# Server-only. Do not use NUXT_PUBLIC_ for API credentials.
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
NUXT_DEMO_SESSION_SECRET=

# Keep false. Public browsing uses saved images; operator authoring is separate.
NUXT_ENABLE_LIVE_UPLOADS=false
NUXT_ENABLE_GENERATION=false
